# Infinite Tutorial Frontend Environment Configuration
# Set the backend API URL.
#
# Production (Render backend):
# VITE_API_BASE_URL=https://infinite-tutorial-1.onrender.com
#
# Local development (direct to local backend):
# VITE_API_BASE_URL=http://localhost:5000
#
# Note: Do NOT add backend secrets (DATABASE_URL, JWT_SECRET, Cloudinary secret, etc.) here.
VITE_API_BASE_URL=https://infinite-tutorial-1.onrender.com
